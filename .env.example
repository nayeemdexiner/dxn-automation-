# Nayeem AI Desk Environment Configuration Template
# Copy this file to .env for local deployment. Never commit real secrets.

# ==========================================
# 1. CORE & ADMIN AUTHENTICATION
# ==========================================
PORT=3000
NODE_ENV="development"
ADMIN_USERNAME="nayeem"
# Set a strong password for initial admin login:
ADMIN_PASSWORD="ChangeMe_NayeemAdmin2026!"
SESSION_SECRET="super-secure-random-session-secret-key-replace-in-production"

# ==========================================
# 2. GEMINI AI API (Server-Side Only)
# ==========================================
# In Google AI Studio, injected automatically via Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==========================================
# 3. POSTGRESQL DATABASE
# ==========================================
# Direct connection string for PostgreSQL (Supabase Free Tier, Render, Neon, or local):
# Supabase Pooler Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/nayeem_ai_desk"
# Alternatively, discrete parameters:
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD="password"
# SQL_DB_NAME="nayeem_ai_desk"

# ==========================================
# 4. META WHATSAPP CLOUD API
# ==========================================
# Webhook verification token you specify in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token_here"
# WhatsApp Cloud API Permanent or System User Access Token:
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_system_user_access_token"
# Phone Number ID from WhatsApp Cloud API dashboard:
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
# Meta App Secret for validating incoming X-Hub-Signature-256 HMAC:
META_APP_SECRET="your_meta_app_secret"

# ==========================================
# 5. TELEGRAM BOT (Admin Notifications & Approval)
# ==========================================
# Telegram Bot Token from @BotFather:
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# Muhammad Nayeem's Telegram Chat ID to receive instant approval alerts:
TELEGRAM_ADMIN_CHAT_ID="your_telegram_admin_chat_id"

# ==========================================
# 6. APP HOSTING
# ==========================================
APP_URL="http://localhost:3000"
